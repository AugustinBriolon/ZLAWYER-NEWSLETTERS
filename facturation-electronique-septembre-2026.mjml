<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all
        font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        color="#394454"
      />
      <mj-text font-size="16px" line-height="1.55" padding="0" align="left" />
      <mj-section padding="0" />
      <mj-column padding="0" width="100%" />
      <mj-button
        background-color="#ED630F"
        color="#ffffff"
        border-radius="999px"
        font-weight="600"
        inner-padding="12px 24px"
        padding="0"
      />
      <mj-divider
        border-color="#CBD5E1"
        border-width="1px"
        padding="0"
        width="60%"
      />
      <mj-image padding="0" />
    </mj-attributes>

    <mj-title
      >La facturation électronique se concrétise. Et zLawyer aussi.</mj-title
    >
    <mj-preview
      >Dès septembre 2026 : recevez vos factures électroniques. Point sur
      zLawyer et les prochaines étapes.</mj-preview
    >

    <mj-style>
      .outlook-fix {
        mso-line-height-rule: exactly;
      }
      [data-ogsc] {
        color: inherit !important;
      }
      [data-ogsb] {
        background-color: inherit !important;
      }
      a {
        text-decoration: none !important;
      }
      a:link {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:visited {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:hover {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:active {
        color: inherit !important;
        text-decoration: none !important;
      }
      a.zl-link-underline,
      a.zl-link-underline:link,
      a.zl-link-underline:visited,
      a.zl-link-underline:hover,
      a.zl-link-underline:active {
        text-decoration: underline !important;
      }
      /* Largeur pleine pour le contenu (Outlook + clients modernes) */
      .zl-full {
        width: 100% !important;
        max-width: 100% !important;
      }
      .zl-full > table {
        width: 100% !important;
      }
      @media only screen and (max-width: 480px) {
        .zl-product-shot img {
          width: 100% !important;
          max-width: 240px !important;
          height: auto !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff" width="600px">
    <!-- Header -->
    <mj-section padding="32px 24px 0">
      <mj-column width="35%" vertical-align="middle">
        <mj-table>
          <tr>
            <td
              style="
                vertical-align: middle;
                padding: 0;
                height: 40px;
                line-height: 40px;
                mso-line-height-rule: exactly;
                font-size: 0;
                overflow: visible;
              "
              height="40"
            >
              <table
                border="0"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse"
              >
                <tr>
                  <td style="height: 40px; width: 32px; padding: 0">
                    <img
                      src="https://www.zlawyer.fr/logiciel-avocats/images/logos/zeleLogo.png"
                      alt="zLawyer"
                      width="32"
                      height="40"
                      style="
                        display: block;
                        border: 0;
                        outline: none;
                        text-decoration: none;
                        height: 40px;
                        width: 32px;
                      "
                    />
                  </td>
                </tr>
              </table>
            </td>
            <td style="vertical-align: middle; padding-left: 8px">
              <span
                style="
                  font-size: 20px;
                  font-weight: 500;
                  color: #222e3e;
                  line-height: 1.2;
                "
                >zLawyer</span
              >
            </td>
          </tr>
        </mj-table>
      </mj-column>
      <mj-column width="65%" padding-top="5px" vertical-align="middle">
        <mj-text align="right" font-size="11px" line-height="1.5">
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >ACCUEIL</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/contact/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >CONTACT</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/newsletters/"
            style="
              color: #ed630f;
              text-decoration: none;
              mso-color-alt: #ed630f;
            "
            >NEWSLETTER</a
          >
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero : titre centré uniquement -->
    <mj-section padding="56px 24px 24px">
      <mj-column width="100%">
        <mj-text
          padding="0"
          font-size="22px"
          line-height="1.35"
          font-weight="600"
          color="#222E3E"
          align="center"
          >La facturation électronique se concrétise : zLawyer vous accompagne
          dès à présent.</mj-text
        >
      </mj-column>
    </mj-section>

    <!-- Intro — même gutter 24px / pleine largeur que les sections suivantes -->
    <mj-section padding="0 24px 28px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          À l'approche du 1<sup>er</sup> septembre 2026, faisons le point sur ce
          qui est déjà disponible dans zLawyer et sur les prochaines étapes.
        </mj-text>

        <mj-text padding="0" color="#5E6A7B" align="left">
          La réforme de la facturation électronique entre désormais dans sa
          phase concrète. zLawyer est prêt pour la première étape&nbsp;: la
          <strong>réception de vos factures électroniques</strong>.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Section : Dès septembre 2026 -->
    <mj-section padding="28px 24px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 26px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: collapse;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="3"
                bgcolor="#ED630F"
                style="
                  width: 3px;
                  max-width: 3px;
                  background-color: #ed630f;
                  mso-background-color-alt: #ed630f;
                  font-size: 0;
                  line-height: 0;
                "
              >
                &nbsp;
              </td>
              <td width="10" style="width: 10px; font-size: 0; line-height: 0">
                &nbsp;
              </td>
              <td
                style="
                  font-size: 17px;
                  line-height: 1.4;
                  font-weight: 600;
                  color: #222e3e;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Dès septembre 2026&nbsp;: recevez vos factures électroniques
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          À compter du 1<sup>er</sup> septembre 2026, tous les cabinets devront
          être en mesure de recevoir des factures électroniques.
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          À cette date, les grandes entreprises et les ETI auront également
          l'obligation d'émettre leurs factures électroniquement. Les PME et
          indépendants pourront le faire de manière anticipée, avant que cette
          obligation ne s'applique à eux en septembre 2027.
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          Pendant cette période de transition, votre cabinet pourra donc
          recevoir les factures de ses fournisseurs de deux façons&nbsp;:
        </mj-text>

        <mj-text padding="0 0 14px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: collapse;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="28"
                valign="top"
                style="padding: 0 8px 0 0; vertical-align: top; width: 28px"
              >
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  width="20"
                  style="
                    border-collapse: collapse;
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    background-color: #fff0e6;
                    width: 20px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      width="20"
                      height="20"
                      bgcolor="#fff0e6"
                      align="center"
                      valign="middle"
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        background-color: #fff0e6;
                        mso-background-color-alt: #fff0e6;
                        color: #ed630f;
                        mso-color-alt: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        line-height: 20px;
                        mso-line-height-rule: exactly;
                        text-align: center;
                      "
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td
                valign="top"
                style="
                  padding: 0;
                  vertical-align: top;
                  color: #5e6a7b;
                  font-size: 16px;
                  line-height: 1.55;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                <strong>Par voie électronique</strong> via votre Plateforme
                Agréée (PA) pour les fournisseurs déjà soumis à l'obligation ou
                ayant choisi d'anticiper la réforme&nbsp;;
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: collapse;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="28"
                valign="top"
                style="padding: 0 8px 0 0; vertical-align: top; width: 28px"
              >
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  width="20"
                  style="
                    border-collapse: collapse;
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    background-color: #fff0e6;
                    width: 20px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      width="20"
                      height="20"
                      bgcolor="#fff0e6"
                      align="center"
                      valign="middle"
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        background-color: #fff0e6;
                        mso-background-color-alt: #fff0e6;
                        color: #ed630f;
                        mso-color-alt: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        line-height: 20px;
                        mso-line-height-rule: exactly;
                        text-align: center;
                      "
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td
                valign="top"
                style="
                  padding: 0;
                  vertical-align: top;
                  color: #5e6a7b;
                  font-size: 16px;
                  line-height: 1.55;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                <strong>Par vos canaux habituels</strong> (e-mail, courrier…)
                pour les autres fournisseurs, jusqu'à leur entrée dans
                l'obligation d'émission.
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Section : Et concrètement dans zLawyer ? -->
    <mj-section padding="28px 24px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 26px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: collapse;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="3"
                bgcolor="#ED630F"
                style="
                  width: 3px;
                  max-width: 3px;
                  background-color: #ed630f;
                  mso-background-color-alt: #ed630f;
                  font-size: 0;
                  line-height: 0;
                "
              >
                &nbsp;
              </td>
              <td width="10" style="width: 10px; font-size: 0; line-height: 0">
                &nbsp;
              </td>
              <td
                style="
                  font-size: 17px;
                  line-height: 1.4;
                  font-weight: 600;
                  color: #222e3e;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Et concrètement dans zLawyer&nbsp;?
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          Si vous avez choisi <strong>Pennylane</strong> comme PA via zLawyer,
          les factures électroniques adressées à votre cabinet seront
          directement accessibles depuis zLawyer.
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          Si vous avez choisi une autre Plateforme Agréée, vos factures
          électroniques seront réceptionnées via cette plateforme, selon les
          modalités qu'elle propose.
        </mj-text>

        <mj-text
          padding="0 0 16px"
          font-size="16px"
          line-height="1.4"
          font-weight="600"
          color="#222E3E"
          align="left"
          >Vous n'avez pas encore choisi votre PA&nbsp;?</mj-text
        >

        <mj-text padding="0" color="#5E6A7B" align="left">
          Vous pouvez toujours souscrire gratuitement à Pennylane directement
          depuis zLawyer et ainsi bénéficier de son intégration avec votre
          logiciel.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Section : Très prochainement -->
    <mj-section padding="28px 24px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 26px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: collapse;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="3"
                bgcolor="#ED630F"
                style="
                  width: 3px;
                  max-width: 3px;
                  background-color: #ed630f;
                  mso-background-color-alt: #ed630f;
                  font-size: 0;
                  line-height: 0;
                "
              >
                &nbsp;
              </td>
              <td width="10" style="width: 10px; font-size: 0; line-height: 0">
                &nbsp;
              </td>
              <td
                style="
                  font-size: 17px;
                  line-height: 1.4;
                  font-weight: 600;
                  color: #222e3e;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Très prochainement&nbsp;: envoyez vos factures électroniques
                depuis zLawyer
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          La prochaine étape est déjà en cours de développement&nbsp;:
          <strong
            >l'émission de vos factures électroniques depuis zLawyer</strong
          >.
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          Les cabinets ayant souscrit à Pennylane via zLawyer pourront ainsi
          continuer à établir leurs factures dans zLawyer et les transmettre
          électroniquement à leurs clients professionnels, sans changer
          d'outil.
        </mj-text>

        <mj-text padding="0" color="#5E6A7B" align="left">
          Pour les PME et indépendants, cette fonctionnalité pourra être
          utilisée de manière anticipée avant de devenir obligatoire à compter
          du 1<sup>er</sup> septembre 2027.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Section : Anticipez dès maintenant -->
    <mj-section padding="28px 24px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 26px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: collapse;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="3"
                bgcolor="#ED630F"
                style="
                  width: 3px;
                  max-width: 3px;
                  background-color: #ed630f;
                  mso-background-color-alt: #ed630f;
                  font-size: 0;
                  line-height: 0;
                "
              >
                &nbsp;
              </td>
              <td width="10" style="width: 10px; font-size: 0; line-height: 0">
                &nbsp;
              </td>
              <td
                style="
                  font-size: 17px;
                  line-height: 1.4;
                  font-weight: 600;
                  color: #222e3e;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Anticipez dès maintenant
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          En choisissant Pennylane via zLawyer, vous préparez dès aujourd'hui
          votre cabinet aux deux volets de la réforme&nbsp;: recevoir vos
          factures fournisseurs et, très prochainement, envoyer vos factures
          clients directement depuis zLawyer.
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          La souscription est <strong>gratuite</strong> et accessible
          directement depuis zLawyer.
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          Choisir Pennylane comme Plateforme Agréée&nbsp;:
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Capture produit -->
    <mj-section padding="0 24px 28px">
      <mj-column
        width="100%"
        background-color="#FFF7F2"
        border="1px solid #FFE0CC"
        padding="20px 16px"
      >
        <mj-text
          align="center"
          padding="0 0 8px"
          font-size="12px"
          line-height="1.4"
          font-weight="600"
          color="#ED630F"
          >DANS ZLAWYER</mj-text
        >

        <mj-text
          align="center"
          padding="0 0 16px"
          font-size="14px"
          line-height="1.45"
          color="#5E6A7B"
          >Menu <strong>Facturation électronique</strong></mj-text
        >

        <mj-image
          css-class="zl-product-shot"
          src="https://x3h44.mjt.lu/img2/x3h44/615f0f70-d682-4cae-87e5-55d62451e5b2/content"
          alt="Menu Facturation électronique dans zLawyer : Premiers pas, Émission des factures, Réception des factures"
          width="240px"
          height="324px"
          align="center"
          border="1px solid #E2E8F0"
          fluid-on-mobile="true"
          padding="0"
        />

        <mj-text
          align="center"
          padding="12px 0 0"
          font-size="12px"
          line-height="1.5"
          color="#94A3B8"
          >Premiers pas &middot; Émission &middot; Réception</mj-text
        >
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Signature -->
    <mj-section padding="28px 24px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0" color="#5E6A7B" align="left">
          <strong>L'équipe zLawyer</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="16px 24px 28px">
      <mj-column width="100%">
        <mj-text align="center" padding="0 0 8px" font-size="12px" color="#5E6A7B"
          >© zLawyer — Tous droits réservés</mj-text
        >
        <mj-text align="center" padding="0" font-size="12px" color="#5E6A7B">
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="https://www.zlawyer.fr/logiciel-avocats/politques-de-confidentialite/"
            >Confidentialité</a
          >
          •
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="https://www.zlawyer.fr/logiciel-avocats/politique-de-cookies/"
            >Cookies</a
          >
          •
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="[[UNSUB_LINK_FR_FR]]"
            >Se désabonner</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
