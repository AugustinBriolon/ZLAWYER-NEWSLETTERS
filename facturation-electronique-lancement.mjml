<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all
        font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        color="#394454"
      />
      <mj-text font-size="16px" line-height="1.6" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-button
        background-color="#ED630F"
        color="#ffffff"
        border-radius="999px"
        font-weight="600"
        inner-padding="12px 24px"
      />
    </mj-attributes>

    <mj-title
      >La facturation électronique c'est maintenant avec zLawyer et
      Pennylane</mj-title
    >
    <mj-preview
      >Activez votre Plateforme Agréée Pennylane dès aujourd'hui depuis
      zLawyer</mj-preview
    >

    <mj-style>
      .outlook-fix {
        mso-line-height-rule: exactly;
      } /* Force les couleurs pour Outlook PC */
      [data-ogsc] {
        color: inherit !important;
      }
      [data-ogsb] {
        background-color: inherit !important;
      } /* Empêche les changements de couleur des liens
      au survol */
      a {
        text-decoration: none !important;
      }
      a:link {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:visited {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:hover {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:active {
        color: inherit !important;
        text-decoration: none !important;
      }
      /* Liens explicitement soulignés (les règles ci-dessus utilisent none !important) */
      a.zl-link-underline,
      a.zl-link-underline:link,
      a.zl-link-underline:visited,
      a.zl-link-underline:hover,
      a.zl-link-underline:active {
        text-decoration: underline !important;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff">
    <!-- Header -->
    <mj-section padding="20px 20px 0 20px">
      <mj-column width="35%" vertical-align="middle">
        <mj-table>
          <tr>
            <td
              style="
                vertical-align: middle;
                padding: 0;
                height: 40px;
                line-height: 40px;
                mso-line-height-rule: exactly;
                font-size: 0;
                overflow: visible;
              "
              height="40"
            >
              <table
                border="0"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse"
              >
                <tr>
                  <td style="height: 40px; width: 32px; padding: 0">
                    <img
                      src="https://www.zlawyer.fr/logiciel-avocats/images/logos/zeleLogo.png"
                      alt="zLawyer"
                      width="32"
                      height="40"
                      style="
                        display: block;
                        border: 0;
                        outline: none;
                        text-decoration: none;
                        height: 40px;
                        width: 32px;
                      "
                    />
                  </td>
                </tr>
              </table>
            </td>
            <td style="vertical-align: middle; padding-left: 8px">
              <span
                style="
                  font-size: 20px;
                  font-weight: 500;
                  color: #222e3e;
                  line-height: 1.2;
                "
                >zLawyer</span
              >
            </td>
          </tr>
        </mj-table>
      </mj-column>
      <mj-column width="65%" padding-top="5px" vertical-align="middle">
        <mj-text align="right" font-size="11px" line-height="1.5">
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >ACCUEIL</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/contact/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >CONTACT</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="#"
            style="
              color: #ed630f;
              text-decoration: none;
              mso-color-alt: #ed630f;
            "
            >NEWSLETTER</a
          >
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero / Intro -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 24px"
          font-size="22px"
          line-height="1.35"
          font-weight="600"
          color="#222E3E"
          align="center"
          >La facturation électronique c'est maintenant avec zLawyer et
          Pennylane</mj-text
        >
        <mj-text padding="0 0 16px" color="#5E6A7B">Cher client,</mj-text>
        <mj-text padding="0 0 16px" color="#5E6A7B">
          La réforme de la facturation électronique approche à grands pas, mais
          bonne nouvelle :
          <strong
            >la mise en conformité avec la Plateforme Agréée Pennylane, c'est
            dès maintenant&nbsp;!</strong
          >
        </mj-text>
        <mj-text padding="0 0 0" color="#5E6A7B">
          Directement intégrée à <strong>zLawyer</strong> et incluse dans votre
          abonnement, vous pouvez dès aujourd'hui activer votre Plateforme
          Agréée et anticiper sereinement les échéances de
          <strong>septembre 2026 et 2027</strong>.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Section : Comment activer -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 16px"
          font-size="17px"
          line-height="1.5"
          font-weight="600"
          color="#222E3E"
          ><div style="border-left: 3px solid #ED630F; padding-left: 10px; margin: 0;">Comment activer votre Plateforme Agréée&nbsp;?</div></mj-text
        >
        <mj-text padding="0 0 16px" color="#5E6A7B">
          L'activation est simple et rapide, directement depuis
          <strong>zLawyer</strong>&nbsp;:
        </mj-text>

        <mj-text padding="0 0 12px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">1</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                <strong>Connectez-vous à votre compte zLawyer</strong><br />
                Accédez à la plateforme et identifiez-vous avec vos identifiants
                habituels.
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 12px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">2</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                <strong>Signez le mandat</strong><br />
                Depuis la page [Nom de la page], signez le mandat pour désigner
                zLawyer comme votre Solution Compatible (SC) à la Plateforme
                Agréée (PA) Pennylane.
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 16px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">3</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                <strong>C'est terminé&nbsp;!</strong><br />
                Vous êtes désormais conforme à la réglementation. Recevez et
                émettez vos factures électroniques en toute sérénité, zLawyer
                gère le reste pour vous.
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 16px">
          <table border="0" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; background-color: #F8F9FB; border-left: 3px solid #ED630F;">
            <tr>
              <td style="padding: 12px 16px; color: #5e6a7b; font-size: 15px; line-height: 1.6; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
                ⏱&nbsp; Temps estimé : <strong>5 minutes</strong>
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 16px" color="#5E6A7B">
          Découvrez comment faire en vidéo&nbsp;:
        </mj-text>
        <mj-button href="#" align="left">Voir la vidéo de démonstration</mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Section : Avantages immédiats -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 16px"
          font-size="17px"
          line-height="1.5"
          font-weight="600"
          color="#222E3E"
          ><div style="border-left: 3px solid #ED630F; padding-left: 10px; margin: 0;">Vos avantages immédiats</div></mj-text
        >
        <mj-text padding="0 0 16px" color="#5E6A7B">
          En activant Pennylane dès aujourd'hui, vous bénéficiez de&nbsp;:
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                <strong>Conformité&nbsp;:</strong> soyez prêt avant les
                échéances légales de 2026/2027
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                <strong>Réception immédiate&nbsp;:</strong> commencez à recevoir
                vos factures électroniques au format Factur-X
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                <strong>Centralisation&nbsp;:</strong> toutes vos factures
                (émises et reçues) au même endroit
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                <strong>Zéro surcoût&nbsp;:</strong> la PA Pennylane est incluse
                sans frais supplémentaires à zLawyer
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 0">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                <strong>Support dédié&nbsp;:</strong> nos équipes sont là pour
                vous accompagner
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Section : Besoin d'aide -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 16px"
          font-size="17px"
          line-height="1.5"
          font-weight="600"
          color="#222E3E"
          ><div style="border-left: 3px solid #ED630F; padding-left: 10px; margin: 0;">Besoin d'aide&nbsp;?</div></mj-text
        >
        <mj-button href="https://www.zlawyer.fr/logiciel-avocats/contact/" align="left">Contactez-nous</mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Signature -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text padding="0 0 0" color="#5E6A7B">
          Bien cordialement,<br />
          <strong>L'équipe zLawyer</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="24px">
      <mj-column padding="0">
        <mj-text align="center" padding="8px 0" font-size="12px" color="#5E6A7B"
          >© zLawyer — Tous droits réservés</mj-text
        >
        <mj-text align="center" padding="0" font-size="12px" color="#5E6A7B">
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="https://www.zlawyer.fr/logiciel-avocats/politques-de-confidentialite/"
            >Confidentialité</a
          >
          •
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="https://www.zlawyer.fr/logiciel-avocats/politique-de-cookies/"
            >Cookies</a
          >
          •
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="[[UNSUB_LINK_FR_FR]]"
            >Se désabonner</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
