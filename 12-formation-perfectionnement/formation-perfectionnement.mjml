                  cellpadding="0"
                  cellspacing="0"
                  width="20"
                  style="
                    border-collapse: collapse;
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    background-color: #fff0e6;
                    width: 20px;
                  "
