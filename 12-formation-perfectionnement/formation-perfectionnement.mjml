                        text-align: center;
                      "
                    >
                      <span style="color: #ed630f">3</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td
                valign="top"
                style="
                  padding: 0;
                  vertical-align: top;
                  color: #5e6a7b;
                  font-size: 16px;
                  line-height: 1.55;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Encaissements et relances
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
