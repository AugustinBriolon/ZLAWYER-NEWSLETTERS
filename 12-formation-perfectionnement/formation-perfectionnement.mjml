<mjml lang="fr" dir="ltr">
  <mj-head>
    <mj-attributes>
      <mj-all
        font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        color="#394454"
      />
      <mj-text font-size="16px" line-height="1.55" padding="0" align="left" />
      <mj-section padding="0" />
      <mj-column padding="0" width="100%" />
      <mj-button
        background-color="#ED630F"
        color="#ffffff"
        border-radius="999px"
        font-weight="600"
        inner-padding="12px 24px"
        padding="0"
        font-size="14px"
      />
      <mj-divider
        border-color="#CBD5E1"
        border-width="1px"
        padding="0"
        width="60%"
      />
      <mj-image padding="0" />
    </mj-attributes>

    <mj-title>Formation perfectionnement zLawyer — jeudi 1er octobre</mj-title>
    <mj-preview
      >Maîtrisez les fonctions avancées de zLawyer : facturation groupée, états
      de synthèse, encaissements. Groupes de 5, 220 € HT, replay inclus.</mj-preview
    >

    <mj-style>
      .outlook-fix {
        mso-line-height-rule: exactly;
      }
      [data-ogsc] {
        color: inherit !important;
      }
      [data-ogsb] {
        background-color: inherit !important;
      }
      a {
        text-decoration: none !important;
      }
      a:link {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:visited {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:hover {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:active {
        color: inherit !important;
        text-decoration: none !important;
      }
      a.zl-link-underline,
      a.zl-link-underline:link,
      a.zl-link-underline:visited,
      a.zl-link-underline:hover,
      a.zl-link-underline:active {
        text-decoration: underline !important;
      }
      a.zl-btn {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
        text-align: center !important;
        text-decoration: none !important;
      }
      a.zl-btn-fill,
      a.zl-btn-fill:link,
      a.zl-btn-fill:visited,
      a.zl-btn-fill:hover,
      a.zl-btn-fill:active,
      a.zl-btn-fill span {
        color: #ffffff !important;
        text-decoration: none !important;
      }
      .zl-full {
        width: 100% !important;
        max-width: 100% !important;
      }
      .zl-full > table {
        width: 100% !important;
      }
      @media only screen and (max-width: 480px) {
        .zl-head-brand table table {
          margin: 0 auto !important;
        }
        .zl-head-brand td[align] {
          text-align: center !important;
        }
        .zl-head-nav {
          padding-top: 12px !important;
        }
        .zl-head-nav div {
          text-align: center !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff" width="600px">
    <!-- Header -->
    <mj-section padding="32px 24px 0">
      <mj-column width="35%" vertical-align="middle" css-class="zl-head-brand">
        <mj-table width="auto" align="left">
          <tr>
            <td
              style="
                vertical-align: middle;
                padding: 0;
                height: 40px;
                line-height: 40px;
                mso-line-height-rule: exactly;
                font-size: 0;
                overflow: visible;
              "
              height="40"
            >
              <table
                border="0"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse"
              >
                <tr>
                  <td style="height: 40px; width: 32px; padding: 0">
                    <img
                      src="https://www.zlawyer.fr/logiciel-avocats/images/logos/zeleLogo.png"
                      alt="zLawyer"
                      width="32"
                      height="40"
                      style="
                        display: block;
                        border: 0;
                        outline: none;
                        text-decoration: none;
                        height: 40px;
                        width: 32px;
                      "
                    />
                  </td>
                </tr>
              </table>
            </td>
            <td style="vertical-align: middle; padding-left: 8px">
              <span
                style="
                  font-size: 20px;
                  font-weight: 500;
                  color: #222e3e;
                  line-height: 1.2;
                "
                >zLawyer</span
              >
            </td>
          </tr>
        </mj-table>
      </mj-column>
      <mj-column width="65%" padding-top="5px" vertical-align="middle" css-class="zl-head-nav">
        <mj-text align="right" font-size="11px" line-height="1.5">
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >ACCUEIL</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/contact/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >CONTACT</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/newsletters/"
            style="
              color: #ed630f;
              text-decoration: none;
              mso-color-alt: #ed630f;
            "
            >NEWSLETTER</a
          >
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section padding="56px 24px 24px">
      <mj-column width="100%">
        <mj-text
          padding="0"
          font-size="22px"
          line-height="1.35"
          font-weight="600"
          color="#222E3E"
          align="center"
          >Formation perfectionnement zLawyer</mj-text
        >
      </mj-column>
    </mj-section>

    <!-- Intro -->
    <mj-section padding="0 24px 28px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 20px" color="#5E6A7B" align="left"
          >Bonjour,</mj-text
        >
        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          Vous maîtrisez les bases de zLawyer. Mais entre une facturation
          groupée à préparer en urgence ou un état de répartition entre associés
          à sortir avant la prochaine réunion, vous sentez peut-être que
          l'outil a plus à offrir.
        </mj-text>
        <mj-text padding="0" color="#5E6A7B" align="left">
          <strong>Zèle Solutions</strong> vous propose une formation
          perfectionnement, dédiée aux fonctions avancées de zLawyer, animée par
          <strong>Florent Demay</strong>, formateur certifié zLawyer et
          consultant spécialisé cabinets d'avocats.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Session card -->
    <mj-section padding="0 24px 12px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: collapse;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
              background-color: #fff8f4;
              border-left: 3px solid #ed630f;
            "
            bgcolor="#fff8f4"
          >
            <tr>
              <td
                style="
                  padding: 18px 20px;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  background-color: #fff8f4;
                  mso-background-color-alt: #fff8f4;
                "
                bgcolor="#fff8f4"
              >
                <span
                  style="
                    font-size: 22px;
                    font-weight: 700;
                    color: #ed630f;
                    line-height: 1.25;
                  "
                  >220&nbsp;€ HT</span
                >
                <span style="font-size: 14px; color: #5e6a7b; line-height: 1.5"
                  >&nbsp;par participant</span
                ><br />
                <span
                  style="
                    display: block;
                    height: 10px;
                    line-height: 10px;
                    font-size: 0;
                  "
                  >&nbsp;</span
                >
                <span style="font-size: 15px; color: #222e3e; font-weight: 600"
                  >Jeudi 1<sup>er</sup> octobre 2026 · 9h30</span
                ><br />
                <span style="font-size: 14px; color: #5e6a7b; line-height: 1.5"
                  >5 participants max, suivi personnalisé · Replay inclus</span
                >
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Programme -->
    <mj-section padding="28px 24px 8px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 26px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                style="
                  border-left: 3px solid #ed630f;
                  mso-border-left-alt: 3px solid #ed630f;
                  padding: 0 0 0 10px;
                  font-size: 17px;
                  line-height: 1.4;
                  font-weight: 600;
                  color: #222e3e;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Au programme
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 14px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
