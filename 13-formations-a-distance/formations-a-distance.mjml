          >
        </mj-text>
        <mj-raw><!--<![endif]--></mj-raw>
        <mj-text padding="16px 0 0" font-size="13px" color="#5E6A7B" align="center">
          Les places sont limitées à 5 participants par session.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Closing -->
    <mj-section padding="28px 24px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 20px" color="#5E6A7B" align="left"
          >À très bientôt,</mj-text
        >
        <mj-text padding="0" color="#5E6A7B" align="left">
          <strong>L'équipe Zèle Solutions</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="16px 24px 28px">
      <mj-column width="100%">
        <mj-text
          align="center"
          padding="0 0 8px"
          font-size="12px"
          color="#5E6A7B"
          >© zLawyer — Tous droits réservés</mj-text
        >
        <mj-text align="center" padding="0" font-size="12px" color="#5E6A7B">
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="https://www.zlawyer.fr/logiciel-avocats/politques-de-confidentialite/"
            >Confidentialité</a
          >
          •
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="https://www.zlawyer.fr/logiciel-avocats/politique-de-cookies/"
            >Cookies</a
          >
          •
          <a
            style="
              color: #5e6a7b;
              text-decoration: none;
              mso-color-alt: #5e6a7b;
            "
            href="[[UNSUB_LINK_FR_FR]]"
            >Se désabonner</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
