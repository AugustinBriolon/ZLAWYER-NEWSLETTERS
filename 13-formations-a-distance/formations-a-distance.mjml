        </mj-raw>
        <mj-raw><!--[if !mso]><!--></mj-raw>
        <mj-text padding="0" align="center">
          <a
            class="zl-btn zl-btn-fill"
            href="https://www.zlawyer.fr/logiciel-avocats/webinaires/"
            style="
              display: block;
              width: 100%;
              max-width: 280px;
              margin: 0 auto;
              background-color: #ed630f;
              color: #ffffff;
              font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
              font-size: 14px;
              font-weight: 600;
              line-height: 20px;
              padding: 12px 24px;
              text-align: center;
              text-decoration: none;
              border-radius: 999px;
              border: 2px solid #ed630f;
              box-sizing: border-box;
            "
            ><span style="color: #ffffff !important"
              >Consulter le catalogue</span
