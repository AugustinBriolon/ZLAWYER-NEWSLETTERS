              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 14px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
