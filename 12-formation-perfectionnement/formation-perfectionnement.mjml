    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section padding="28px 24px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 24px" color="#5E6A7B" align="left">
          Pour vous inscrire, répondez à cet e-mail ou cliquez sur le bouton
          ci-dessous.
        </mj-text>

        <mj-raw>
          <!--[if mso]>
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
