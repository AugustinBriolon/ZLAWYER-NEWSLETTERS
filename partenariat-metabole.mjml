<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all
        font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        color="#394454"
      />
      <mj-text font-size="16px" line-height="1.55" padding="0" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-button
        background-color="#ED630F"
        color="#ffffff"
        border-radius="999px"
        font-weight="600"
        inner-padding="12px 24px"
        padding="0"
      />
      <mj-divider
        border-color="#CBD5E1"
        border-width="1px"
        padding="0"
        width="60%"
      />
      <mj-image padding="0" />
    </mj-attributes>

    <mj-title>2 mois de zLawyer + 6 mois de SEO offert</mj-title>
    <mj-preview
      >L'été est le meilleur moment pour moderniser votre cabinet avec Metabole</mj-preview
    >

    <mj-style>
      .outlook-fix {
        mso-line-height-rule: exactly;
      } /* Force les couleurs pour Outlook PC */
      [data-ogsc] {
        color: inherit !important;
      }
      [data-ogsb] {
        background-color: inherit !important;
      } /* Empêche les changements de couleur des liens
      au survol */
      a {
        text-decoration: none !important;
      }
      a:link {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:visited {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:hover {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:active {
        color: inherit !important;
        text-decoration: none !important;
      }
      /* Liens explicitement soulignés (les règles ci-dessus utilisent none !important) */
      a.zl-link-underline,
      a.zl-link-underline:link,
      a.zl-link-underline:visited,
      a.zl-link-underline:hover,
      a.zl-link-underline:active {
        text-decoration: underline !important;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff" width="600px">
    <!-- Header -->
