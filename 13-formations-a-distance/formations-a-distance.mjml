<mjml lang="fr" dir="ltr">
  <mj-head>
    <mj-attributes>
      <mj-all
        font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        color="#394454"
      />
      <mj-text font-size="16px" line-height="1.55" padding="0" align="left" />
      <mj-section padding="0" />
      <mj-column padding="0" width="100%" />
      <mj-button
        background-color="#ED630F"
        color="#ffffff"
        border-radius="999px"
        font-weight="600"
        inner-padding="12px 24px"
        padding="0"
        font-size="14px"
      />
      <mj-divider
        border-color="#CBD5E1"
        border-width="1px"
        padding="0"
        width="60%"
      />
      <mj-image padding="0" />
    </mj-attributes>

    <mj-title>Découvrez notre catalogue de formations zLawyer et développez vos compétences !</mj-title>
    <mj-preview
      >Formations zLawyer à distance : petits groupes de 5 participants
      maximum, échanges avec le formateur, replay. Réservez votre place !</mj-preview
    >

    <mj-style>
      .outlook-fix {
        mso-line-height-rule: exactly;
      }
      [data-ogsc] {
        color: inherit !important;
      }
      [data-ogsb] {
        background-color: inherit !important;
      }
      a {
        text-decoration: none !important;
      }
      a:link {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:visited {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:hover {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:active {
        color: inherit !important;
        text-decoration: none !important;
      }
      a.zl-link-underline,
      a.zl-link-underline:link,
      a.zl-link-underline:visited,
      a.zl-link-underline:hover,
      a.zl-link-underline:active {
        text-decoration: underline !important;
      }
      a.zl-btn {
        display: block !important;
        width: 100% !important;
        box-sizing: border-box !important;
        text-align: center !important;
        text-decoration: none !important;
      }
      a.zl-btn-fill,
      a.zl-btn-fill:link,
      a.zl-btn-fill:visited,
      a.zl-btn-fill:hover,
      a.zl-btn-fill:active,
      a.zl-btn-fill span {
        color: #ffffff !important;
        text-decoration: none !important;
      }
      .zl-full {
        width: 100% !important;
        max-width: 100% !important;
      }
      .zl-full > table {
        width: 100% !important;
      }
      @media only screen and (max-width: 480px) {
        .zl-head-brand table table {
          margin: 0 auto !important;
        }
        .zl-head-brand td[align] {
          text-align: center !important;
        }
        .zl-head-nav {
          padding-top: 12px !important;
        }
        .zl-head-nav div {
          text-align: center !important;
        }
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff" width="600px">
    <!-- Header -->
    <mj-section padding="32px 24px 0">
      <mj-column width="35%" vertical-align="middle" css-class="zl-head-brand">
        <mj-table width="auto" align="left">
          <tr>
            <td
              style="
                vertical-align: middle;
                padding: 0;
                height: 40px;
                line-height: 40px;
                mso-line-height-rule: exactly;
                font-size: 0;
                overflow: visible;
              "
              height="40"
            >
              <table
                border="0"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse"
              >
                <tr>
                  <td style="height: 40px; width: 32px; padding: 0">
                    <img
                      src="https://www.zlawyer.fr/logiciel-avocats/images/logos/zeleLogo.png"
                      alt="zLawyer"
                      width="32"
                      height="40"
                      style="
                        display: block;
                        border: 0;
                        outline: none;
                        text-decoration: none;
                        height: 40px;
                        width: 32px;
                      "
                    />
                  </td>
                </tr>
              </table>
            </td>
            <td style="vertical-align: middle; padding-left: 8px">
              <span
                style="
                  font-size: 20px;
                  font-weight: 500;
                  color: #222e3e;
                  line-height: 1.2;
                "
                >zLawyer</span
              >
            </td>
          </tr>
        </mj-table>
      </mj-column>
      <mj-column
        width="65%"
        padding-top="5px"
        vertical-align="middle"
        css-class="zl-head-nav"
      >
        <mj-text align="right" font-size="11px" line-height="1.5">
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >ACCUEIL</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/contact/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >CONTACT</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/newsletters/"
            style="
              color: #ed630f;
              text-decoration: none;
              mso-color-alt: #ed630f;
            "
            >NEWSLETTER</a
          >
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section padding="56px 24px 24px">
      <mj-column width="100%">
        <mj-text
          padding="0"
          font-size="22px"
          line-height="1.35"
          font-weight="600"
          color="#222E3E"
          align="center"
          >Découvrez notre catalogue de formations zLawyer et développez vos
          compétences&nbsp;!</mj-text
        >
      </mj-column>
    </mj-section>

    <!-- Intro -->
    <mj-section padding="0 24px 28px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          Vous souhaitez approfondir vos connaissances, revoir les fondamentaux
          ou maîtriser des fonctionnalités que vous n'utilisez pas
          encore&nbsp;?
        </mj-text>
        <mj-text padding="0" color="#5E6A7B" align="left">
          Nos <strong>formations à distance</strong> sont conçues pour vous
          aider à exploiter pleinement zLawyer et à gagner en efficacité au
          quotidien.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Pourquoi participer -->
    <mj-section padding="28px 24px 8px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 26px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                style="
                  border-left: 3px solid #ed630f;
                  mso-border-left-alt: 3px solid #ed630f;
                  padding: 0 0 0 10px;
                  font-size: 17px;
                  line-height: 1.4;
                  font-weight: 600;
                  color: #222e3e;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Pourquoi participer&nbsp;?
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 14px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="28"
                valign="top"
                style="padding: 2px 8px 0 0; vertical-align: top; width: 28px"
              >
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  width="20"
                  style="
                    border-collapse: collapse;
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    background-color: #fff0e6;
                    width: 20px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      width="20"
                      height="20"
                      bgcolor="#fff0e6"
                      align="center"
                      valign="middle"
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        background-color: #fff0e6;
                        mso-background-color-alt: #fff0e6;
                        color: #ed630f;
                        mso-color-alt: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        line-height: 20px;
                        mso-line-height-rule: exactly;
                        text-align: center;
                      "
                    >
                      <span style="color: #ed630f">&#10003;</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td
                valign="top"
                style="
                  padding: 0;
                  vertical-align: top;
                  color: #5e6a7b;
                  font-size: 16px;
                  line-height: 1.55;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Des formations pratiques, adaptées aux besoins des cabinets d'avocats
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 14px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="28"
                valign="top"
                style="padding: 2px 8px 0 0; vertical-align: top; width: 28px"
              >
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  width="20"
                  style="
                    border-collapse: collapse;
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    background-color: #fff0e6;
                    width: 20px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      width="20"
                      height="20"
                      bgcolor="#fff0e6"
                      align="center"
                      valign="middle"
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        background-color: #fff0e6;
                        mso-background-color-alt: #fff0e6;
                        color: #ed630f;
                        mso-color-alt: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        line-height: 20px;
                        mso-line-height-rule: exactly;
                        text-align: center;
                      "
                    >
                      <span style="color: #ed630f">&#10003;</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td
                valign="top"
                style="
                  padding: 0;
                  vertical-align: top;
                  color: #5e6a7b;
                  font-size: 16px;
                  line-height: 1.55;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Des petits groupes de <strong>5 participants maximum</strong> pour un accompagnement personnalisé
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 14px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="28"
                valign="top"
                style="padding: 2px 8px 0 0; vertical-align: top; width: 28px"
              >
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  width="20"
                  style="
                    border-collapse: collapse;
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    background-color: #fff0e6;
                    width: 20px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      width="20"
                      height="20"
                      bgcolor="#fff0e6"
                      align="center"
                      valign="middle"
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        background-color: #fff0e6;
                        mso-background-color-alt: #fff0e6;
                        color: #ed630f;
                        mso-color-alt: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        line-height: 20px;
                        mso-line-height-rule: exactly;
                        text-align: center;
                      "
                    >
                      <span style="color: #ed630f">&#10003;</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td
                valign="top"
                style="
                  padding: 0;
                  vertical-align: top;
                  color: #5e6a7b;
                  font-size: 16px;
                  line-height: 1.55;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Des échanges directs avec le formateur pour répondre à vos questions
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                width="28"
                valign="top"
                style="padding: 2px 8px 0 0; vertical-align: top; width: 28px"
              >
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  width="20"
                  style="
                    border-collapse: collapse;
                    mso-table-lspace: 0pt;
                    mso-table-rspace: 0pt;
                    background-color: #fff0e6;
                    width: 20px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      width="20"
                      height="20"
                      bgcolor="#fff0e6"
                      align="center"
                      valign="middle"
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        background-color: #fff0e6;
                        mso-background-color-alt: #fff0e6;
                        color: #ed630f;
                        mso-color-alt: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        line-height: 20px;
                        mso-line-height-rule: exactly;
                        text-align: center;
                      "
                    >
                      <span style="color: #ed630f">&#10003;</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td
                valign="top"
                style="
                  padding: 0;
                  vertical-align: top;
                  color: #5e6a7b;
                  font-size: 16px;
                  line-height: 1.55;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Un <strong>replay</strong> disponible pour revoir la formation à votre rythme
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="16px 24px">
      <mj-column width="100%">
        <mj-divider />
      </mj-column>
    </mj-section>

    <!-- Catalogue -->
    <mj-section padding="28px 24px">
      <mj-column width="100%" css-class="zl-full">
        <mj-text padding="0 0 26px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
              mso-table-lspace: 0pt;
              mso-table-rspace: 0pt;
              width: 100%;
            "
          >
            <tr>
              <td
                style="
                  border-left: 3px solid #ed630f;
                  mso-border-left-alt: 3px solid #ed630f;
                  padding: 0 0 0 10px;
                  font-size: 17px;
                  line-height: 1.4;
                  font-weight: 600;
                  color: #222e3e;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Quelques heures de formation pour gagner du temps chaque jour&nbsp;!
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 20px" color="#5E6A7B" align="left">
          Facturation avancée, gestion des dossiers, suivi de l'activité du
          cabinet… Découvrez tout ce que zLawyer peut encore vous
          apporter&nbsp;!
        </mj-text>
        <mj-text padding="0 0 24px" color="#5E6A7B" align="left">
          Consultez notre catalogue de formations et
          <strong>réservez votre place</strong>&nbsp;!
        </mj-text>

        <mj-raw>
          <!--[if mso]>
          <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr>
              <td align="center">
                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="https://www.zlawyer.fr/logiciel-avocats/webinaires/" style="height:44px;v-text-anchor:middle;width:280px;" arcsize="50%" stroke="f" fillcolor="#ED630F">
                  <w:anchorlock/>
                  <center style="color:#ffffff;font-family:'Segoe UI',sans-serif;font-size:14px;font-weight:600;">Consulter le catalogue</center>
