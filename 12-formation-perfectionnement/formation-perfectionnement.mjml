                  color: #5e6a7b;
                  font-size: 16px;
                  line-height: 1.55;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                  text-align: left;
                "
              >
                Paramétrage avancé des dossiers et préparation à la facturation
                électronique
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 14px" align="left">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            role="presentation"
            style="
              border-collapse: separate;
              border-spacing: 0;
