<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all
        font-family="'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        color="#394454"
      />
      <mj-text font-size="16px" line-height="1.6" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-button
        background-color="#ED630F"
        color="#ffffff"
        border-radius="999px"
        font-weight="600"
        inner-padding="12px 24px"
      />
    </mj-attributes>

    <mj-title
      >Collaborateurs : découvrez la nouvelle offre zLawyer à 17€/mois</mj-title
    >
    <mj-preview
      >Votre propre compte zLawyer pour gérer votre activité indépendante — 17€ HT/mois, sans engagement</mj-preview
    >

    <mj-style>
      .outlook-fix {
        mso-line-height-rule: exactly;
      } /* Force les couleurs pour Outlook PC */
      [data-ogsc] {
        color: inherit !important;
      }
      [data-ogsb] {
        background-color: inherit !important;
      } /* Empêche les changements de couleur des liens
      au survol */
      a {
        text-decoration: none !important;
      }
      a:link {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:visited {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:hover {
        color: inherit !important;
        text-decoration: none !important;
      }
      a:active {
        color: inherit !important;
        text-decoration: none !important;
      }
      /* Liens explicitement soulignés (les règles ci-dessus utilisent none !important) */
      a.zl-link-underline,
      a.zl-link-underline:link,
      a.zl-link-underline:visited,
      a.zl-link-underline:hover,
      a.zl-link-underline:active {
        text-decoration: underline !important;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#ffffff">
    <!-- Header -->
    <mj-section padding="20px 20px 0 20px">
      <mj-column width="35%" vertical-align="middle">
        <mj-table>
          <tr>
            <td
              style="
                vertical-align: middle;
                padding: 0;
                height: 40px;
                line-height: 40px;
                mso-line-height-rule: exactly;
                font-size: 0;
                overflow: visible;
              "
              height="40"
            >
              <table
                border="0"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse"
              >
                <tr>
                  <td style="height: 40px; width: 32px; padding: 0">
                    <img
                      src="https://www.zlawyer.fr/logiciel-avocats/images/logos/zeleLogo.png"
                      alt="zLawyer"
                      width="32"
                      height="40"
                      style="
                        display: block;
                        border: 0;
                        outline: none;
                        text-decoration: none;
                        height: 40px;
                        width: 32px;
                      "
                    />
                  </td>
                </tr>
              </table>
            </td>
            <td style="vertical-align: middle; padding-left: 8px">
              <span
                style="
                  font-size: 20px;
                  font-weight: 500;
                  color: #222e3e;
                  line-height: 1.2;
                "
                >zLawyer</span
              >
            </td>
          </tr>
        </mj-table>
      </mj-column>
      <mj-column width="65%" padding-top="5px" vertical-align="middle">
        <mj-text align="right" font-size="11px" line-height="1.5">
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >ACCUEIL</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/contact/"
            style="
              color: #394454;
              text-decoration: none;
              mso-color-alt: #394454;
            "
            >CONTACT</a
          >&nbsp;&nbsp;&nbsp;/&nbsp;&nbsp;&nbsp;
          <a
            href="https://www.zlawyer.fr/logiciel-avocats/newsletters/"
            style="
              color: #ed630f;
              text-decoration: none;
              mso-color-alt: #ed630f;
            "
            >NEWSLETTER</a
          >
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero / Intro -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 24px"
          font-size="22px"
          line-height="1.35"
          font-weight="600"
          color="#222E3E"
          align="center"
          >Une nouvelle offre dédiée aux collaborateurs des cabinets zLawyer</mj-text
        >
        <mj-text padding="0 0 16px" color="#5E6A7B">Bonjour,</mj-text>
        <mj-text padding="0 0 16px" color="#5E6A7B">
          Vous utilisez déjà zLawyer au sein de votre cabinet ?
        </mj-text>
        <mj-text padding="0 0 0" color="#5E6A7B">
          Nous lançons aujourd'hui une nouvelle offre spécialement conçue pour
          les <strong>collaborateurs des cabinets équipés de zLawyer</strong>,
          afin de gérer votre activité indépendante en toute simplicité.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Section : L'offre -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 16px"
          font-size="17px"
          line-height="1.5"
          font-weight="600"
          color="#222E3E"
          ><div
            style="
              border-left: 3px solid #ed630f;
              padding-left: 10px;
              margin: 0;
            "
          >
            zLawyer Collaborateur
          </div></mj-text
        >

        <mj-text padding="0 0 16px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="
              border-collapse: collapse;
              background-color: #fff8f4;
              border-left: 3px solid #ed630f;
            "
          >
            <tr>
              <td
                style="
                  padding: 16px 20px;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                "
              >
                <span
                  style="
                    font-size: 28px;
                    font-weight: 700;
                    color: #ed630f;
                    line-height: 1.2;
                  "
                  >17€ HT / mois</span
                ><br />
                <span style="font-size: 14px; color: #5e6a7b"
                  >Sans engagement</span
                >
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 16px" color="#5E6A7B">
          Cette offre vous permet de disposer de votre propre compte zLawyer
          pour gérer votre activité indépendante. Concrètement, vous
          pouvez&nbsp;:
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                Refacturer le cabinet dans lequel vous exercez
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                Gérer vos dossiers personnels
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                Émettre vos factures électroniques
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                Suivre votre activité et votre chiffre d'affaires
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                Accéder à vos tableaux de bord financiers
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 8px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                Relancer vos impayés
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-text padding="0 0 0">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            style="border-collapse: collapse"
          >
            <tr>
              <td style="padding: 0 8px 0 0; vertical-align: top">
                <table
                  border="0"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    border-collapse: collapse;
                    background-color: #fff0e6;
                    border-radius: 999px;
                  "
                  bgcolor="#fff0e6"
                >
                  <tr>
                    <td
                      style="
                        width: 20px;
                        height: 20px;
                        padding: 0;
                        font-size: 12px;
                        font-weight: 600;
                        color: #ed630f;
                        font-family: 'Segoe UI', sans-serif;
                        border-radius: 999px;
                        line-height: 20px;
                        text-align: center;
                      "
                      bgcolor="#fff0e6"
                      width="20"
                      height="20"
                    >
                      <span style="color: #ed630f">✓</span>
                    </td>
                  </tr>
                </table>
              </td>
              <td style="padding: 0; vertical-align: top; color: #5e6a7b">
                Utiliser l'application mobile zLawyer
              </td>
            </tr>
          </table>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Section : Pourquoi cette offre -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 16px"
          font-size="17px"
          line-height="1.5"
          font-weight="600"
          color="#222E3E"
          ><div
            style="
              border-left: 3px solid #ed630f;
              padding-left: 10px;
              margin: 0;
            "
          >
            Pourquoi cette offre&nbsp;?
          </div></mj-text
        >
        <mj-text padding="0 0 16px" color="#5E6A7B">
          De nombreux collaborateurs sont amenés à exercer une activité
          indépendante en parallèle de leur collaboration au cabinet.
        </mj-text>
        <mj-text padding="0 0 0" color="#5E6A7B">
          <strong>zLawyer Collaborateur</strong> leur permet de bénéficier
          d'une plateforme dédiée à cette activité, tout en restant
          parfaitement autonomes.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Section : Facturation électronique incluse -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 16px"
          font-size="17px"
          line-height="1.5"
          font-weight="600"
          color="#222E3E"
          ><div
            style="
              border-left: 3px solid #ed630f;
              padding-left: 10px;
              margin: 0;
            "
          >
            Facturation électronique incluse
          </div></mj-text
        >
        <mj-text padding="0 0 0" color="#5E6A7B">
          Avec la réforme de la facturation électronique qui entre
          progressivement en vigueur, vous disposez dès aujourd'hui d'un outil
          conforme pour gérer vos factures électroniques en toute sérénité.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Section : Conditions d'accès -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text
          padding="0 0 16px"
          font-size="17px"
          line-height="1.5"
          font-weight="600"
          color="#222E3E"
          ><div
            style="
              border-left: 3px solid #ed630f;
              padding-left: 10px;
              margin: 0;
            "
          >
            Conditions d'accès
          </div></mj-text
        >
        <mj-text padding="0 0 16px" color="#5E6A7B">
          L'offre <strong>zLawyer Collaborateur</strong> est exclusivement
          réservée aux collaborateurs déjà utilisateurs de zLawyer via leur
          cabinet.
        </mj-text>

        <mj-text padding="0 0 16px">
          <table
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="
              border-collapse: collapse;
              background-color: #f8f9fb;
              border-left: 3px solid #ed630f;
            "
          >
            <tr>
              <td
                style="
                  padding: 12px 16px;
                  color: #5e6a7b;
                  font-size: 15px;
                  line-height: 1.6;
                  font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                "
              >
                <strong style="color: #222e3e">17€ HT / mois</strong>
                — Sans engagement
              </td>
            </tr>
          </table>
        </mj-text>

        <mj-button
          href="https://www.zlawyer.fr/logiciel-avocats/contact/"
          align="left"
          color="#ffffff"
          >Je souhaite m'abonner</mj-button
        >
      </mj-column>
    </mj-section>

    <mj-section padding="0 24px">
      <mj-column padding="0">
        <mj-divider
          border-color="#CBD5E1"
          border-width="1px"
          padding="12px 0"
          width="60%"
        />
      </mj-column>
    </mj-section>

    <!-- Signature -->
    <mj-section padding="24px">
      <mj-column padding="0 24px">
        <mj-text padding="0 0 0" color="#5E6A7B">
          Bien cordialement,<br />
          <strong>L'équipe zLawyer</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="24px">
      <mj-column padding="0">
        <mj-text align="center" padding="8px 0" font-size="12px" color="#5E6A7B"
          >© zLawyer — Tous droits réservés</mj-text
